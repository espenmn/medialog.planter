<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="medialog.planter">

 <!-- -*- extra stuff goes here -*- -->

  <browser:page
    name="planter-import"
    for="*"
    class=".planter_import.PlanterImport"
    template="planter_import.pt"
    permission="zope2.View"
    layer="medialog.planter.interfaces.IMedialogPlanterLayer"
    />

  <browser:page
    name="plante-view"
    for="*"
    class=".plante_view.PlanteView"
    template="plante_view.pt"
    permission="zope2.View"
    layer="medialog.planter.interfaces.IMedialogPlanterLayer"
    />

</configure>
